# TLS Secret Template Example
# DO NOT commit production private keys to Git.
# Generate self-signed certificates or inject via Vault CSI / cert-manager.
apiVersion: v1
kind: Secret
metadata:
  name: mdm-tls-secret
  namespace: mdm-system
type: kubernetes.io/tls
stringData:
  tls.crt: |
    -----BEGIN CERTIFICATE-----
    # Paste your certificate here
    -----END CERTIFICATE-----
  tls.key: |
    -----BEGIN PRIVATE KEY-----
    # Paste your private key here
    -----END PRIVATE KEY-----
