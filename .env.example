# Database Configuration (Default: H2 File Database)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=domain_system
DB_USERNAME=sa
DB_PASSWORD=
DB_URL=jdbc:h2:file:./data/mplatform;MODE=PostgreSQL;AUTO_SERVER=TRUE;DB_CLOSE_DELAY=-1
DB_DRIVER_CLASS_NAME=org.h2.Driver
DB_DIALECT=org.hibernate.dialect.H2Dialect

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_which_must_be_at_least_256_bits_long_for_hs256_security
JWT_ACCESS_EXPIRATION_SEC=1800
JWT_REFRESH_EXPIRATION_SEC=172800

# Storage Directory
FILE_UPLOAD_DIR=./uploads

# encryption secret-key
ENCRYPTION_SECRET_KEY=your_encryption_secret_key_which_must_be_at_least_256_bits_long

