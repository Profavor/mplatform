# Database Settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=domain_system
DB_USERNAME=postgres
DB_PASSWORD=password

# JWT Configuration
JWT_SECRET=YOUR_SUPER_SECRET_KEY_FOR_JWT_AUTHENTICATION_OVER_256_BITS
JWT_ACCESS_EXPIRATION_SEC=1800
JWT_REFRESH_EXPIRATION_SEC=172800

# Storage Directory
FILE_UPLOAD_DIR=./uploads

# encryption secret-key
ENCRYPTION_SECRET_KEY=your_encryption_secret_key_which_must_be_at_least_256_bits_long

# Frontend Services
NUXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# OpenSearch
OPENSEARCH_URIS=http://localhost:9200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# OAuth2
OAUTH2_ISSUER_URI=http://localhost:8080/realms/mplatform

# Storage (MinIO)
STORAGE_TYPE=minio
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=domain-system

# Application
PORT=8080
SPRING_PROFILES_ACTIVE=prod
DDL_AUTO=update

# Chat
CHAT_RETENTION_DAYS=7

# JWT
JWT_EXPIRATION=86400000

# Integration JDBC Pool
INTEGRATION_JDBC_MAX_POOL_SIZE=5
INTEGRATION_JDBC_CONNECTION_TIMEOUT=5000
INTEGRATION_JDBC_VALIDATION_TIMEOUT=3000
INTEGRATION_JDBC_MAX_LIFETIME=600000

# Integration WebService Timeouts
INTEGRATION_WEBSERVICE_CONNECT_TIMEOUT_MS=5000
INTEGRATION_WEBSERVICE_READ_TIMEOUT_MS=10000

# Integration Scheduler
INTEGRATION_SCHEDULER_POOL_SIZE=4
