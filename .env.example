# ==============================================================================
# Master Data Management (MDM) System Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Settings (PostgreSQL 15)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=domain_system
DB_USERNAME=postgres
DB_PASSWORD=password

# ------------------------------------------------------------------------------
# 2. Server & Profile Settings
# ------------------------------------------------------------------------------
PORT=8080
SPRING_PROFILES_ACTIVE=prod
DDL_AUTO=update

# ------------------------------------------------------------------------------
# 3. JWT Authentication Configuration
# ------------------------------------------------------------------------------
JWT_SECRET=YOUR_SUPER_SECRET_KEY_FOR_JWT_AUTHENTICATION_OVER_256_BITS
JWT_ACCESS_EXPIRATION_SEC=1800
JWT_REFRESH_EXPIRATION_SEC=172800

# ------------------------------------------------------------------------------
# 4. Data Encryption & Vault Configuration
# ------------------------------------------------------------------------------
ENCRYPTION_TYPE=LOCAL
ENCRYPTION_SECRET_KEY=your_encryption_secret_key_which_must_be_at_least_256_bits_long
VAULT_URI=http://localhost:8200
VAULT_TOKEN=root

# ------------------------------------------------------------------------------
# 5. Keycloak IAM & OIDC Configuration
# ------------------------------------------------------------------------------
KEYCLOAK_SERVER_URL=http://localhost:8081
KEYCLOAK_REALM=mplatform
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
OAUTH2_ISSUER_URI=http://localhost:8081/realms/mplatform

# ------------------------------------------------------------------------------
# 6. Object Storage (MinIO) & File Upload
# ------------------------------------------------------------------------------
STORAGE_TYPE=minio
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=domain-system
FILE_UPLOAD_DIR=./uploads

# ------------------------------------------------------------------------------
# 7. Distributed Cache, Search & Messaging (Redis, OpenSearch, Kafka, RabbitMQ)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
OPENSEARCH_URIS=http://localhost:9200
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ------------------------------------------------------------------------------
# 8. Platform Features & CORS & Chat
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
DQ_ENGINE_CUSTOM_SPEL_ENABLED=true
CHAT_RETENTION_DAYS=7

# ------------------------------------------------------------------------------
# 9. Mail Server Configuration
# ------------------------------------------------------------------------------
MAIL_DOMAIN=mplatform.com
MAIL_HOSTNAME=mail.mplatform.com
MAIL_ADMIN_USER=admin@mplatform.com
MAIL_ADMIN_PASSWORD=AdminMailPass123!
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=587
MAIL_IMAP_HOST=localhost
MAIL_IMAP_PORT=993
MAIL_SSL_TYPE=self-signed
MAIL_ACCOUNT_AUTO_CREATE=true
MAIL_CONFIG_PATH=./docker-data/dms/config
# Optional: SMTP Relay for cloud environments
# MAIL_RELAY_HOST=smtp.sendgrid.net
# MAIL_RELAY_PORT=587
# MAIL_RELAY_USER=apikey
# MAIL_RELAY_PASSWORD=SG.xxx

# ------------------------------------------------------------------------------
# 10. Integration Channel Timeouts & Pool (Optional - Defaults Applied)
# ------------------------------------------------------------------------------
INTEGRATION_JDBC_MAX_POOL_SIZE=5
INTEGRATION_JDBC_CONNECTION_TIMEOUT=5000
INTEGRATION_JDBC_VALIDATION_TIMEOUT=3000
INTEGRATION_JDBC_MAX_LIFETIME=600000
INTEGRATION_WEBSERVICE_CONNECT_TIMEOUT_MS=5000
INTEGRATION_WEBSERVICE_READ_TIMEOUT_MS=10000
INTEGRATION_SCHEDULER_POOL_SIZE=4

# ------------------------------------------------------------------------------
# 11. Frontend UI Enterprise Licenses (Optional)
# ------------------------------------------------------------------------------
# AG_GRID_LICENSE=your_ag_grid_enterprise_license_key_here

