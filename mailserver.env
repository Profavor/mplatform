# ==============================================================================
# docker-mailserver Environment Configuration
# ==============================================================================

# Core Settings
OVERRIDE_HOSTNAME=mail.mplatform.com
POSTMASTER_ADDRESS=postmaster@mplatform.com
LOG_LEVEL=info
TZ=Asia/Seoul

# SSL/TLS (manual with generated self-signed certs for local dev, letsencrypt for prod)
SSL_TYPE=manual
SSL_CERT_PATH=/tmp/docker-mailserver/ssl/mail.mplatform.com-cert.pem
SSL_KEY_PATH=/tmp/docker-mailserver/ssl/mail.mplatform.com-key.pem

# Security & Spam Filtering
ENABLE_FAIL2BAN=0
ENABLE_RSPAMD=1
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_OPENDKIM=0
ENABLE_OPENDMARC=0
ENABLE_POLICYD_SPF=0
ENABLE_AMAVIS=0
SPOOF_PROTECTION=0
ENABLE_POSTGREY=0

# Relay (disabled by default, configure for cloud environments)
# RELAY_HOST=
# RELAY_PORT=587
# RELAY_USER=
# RELAY_PASSWORD=
